    "mod.cognate-detective.intro": { "text": "English and Spanish share thousands of cognates — words that look alike and mean the same thing. Some are false friends. Cognate Detective helps emergent bilingual students use what they already know to unlock English vocabulary, then verify meaning with context.", "status": "published" },
    "mod.academic-language-lab.intro": { "text": "Emergent bilingual students often understand a concept but need the academic language to express it. The Academic Language Lab builds the words, sentence frames, and talk moves students use to explain, compare, and justify — the language of school across every content area.", "status": "published" },
    "mod.newcomer-navigator.intro": { "text": "Newly arrived students need survival English before academic English: how to ask to use the restroom, what to say in the cafeteria line, how to join a group. Newcomer Navigator uses real school scenarios so students rehearse the words they need on day one — with home-language support throughout.", "status": "published" },
    "prints.intro":         { "text": "Every activity prints. Each sheet is generated from the same content record, so the paper version always matches the screen — a student pack to hand out and an answer key for you, in English, Spanish, or Arabic. When the technology does not work, the activity still does.", "status": "published" },
